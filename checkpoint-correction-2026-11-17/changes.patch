+@dataclass
+class AggregateCheckpointState:
+    """Protected checkpoint; proof verification never changes this state."""
+    shard: int
+    public_key: bytes
+    current: AggregateAnchor | None = None
+
+    def install(self, candidate: AggregateAnchor, verifier: Ed25519Verifier) -> bool:
+        """Process a checkpoint delivery using the configured authority, without rollback."""
+        if candidate.shard != self.shard or candidate.public_key != self.public_key:
+            return False
+        if not verifier.verify(checkpoint_cert_message(candidate.shard, candidate.prefix_count,
+                                                       candidate.accumulator_root), candidate.signature):
+            return False
+        if self.current is not None:
+            if candidate.prefix_count < self.current.prefix_count:
+                return False
+            if (candidate.prefix_count == self.current.prefix_count and
+                    candidate.accumulator_root != self.current.accumulator_root):
+                return False
+        self.current = candidate
+        return True
+
+    def verify(self, expected: RootStatement, evidence: bytes, candidate: AggregateAnchor,
+               verifier: Ed25519Verifier, counter: HashCounter | None = None) -> bool:
+        # A response cannot select an older authentic anchor or replace the protected one.
+        if self.current is None or candidate != self.current:
+            return False
+        return verify_aggregate_evidence(expected, evidence, self.current, verifier, counter)
 
